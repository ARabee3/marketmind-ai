# Copy this file to services/ai/.env and fill in your own keys.
# DO NOT commit .env — it is gitignored and meant for secrets.

# Supported values: mock, openai, gemini_dev, openrouter.
AI_PROVIDER_MODE=mock
# Keep the new orchestration path disabled until its shadow/reconciliation
# gates pass. Existing Discovery, Strategy, Content, and publishing paths are
# unchanged when this is false.
AI_ORCHESTRATION_ENABLED=false
# Phase 5 trace export is independently disabled. Local sanitized traces are
# available only to an explicitly constructed recorder; no network exporter is
# enabled by these defaults.
AI_ORCHESTRATION_TRACE_ENABLED=false
AI_ORCHESTRATION_TRACE_EXPORTER=none
AI_ORCHESTRATION_TRACE_ENVIRONMENT=local
AI_ORCHESTRATION_TRACE_TIMEOUT_MS=500
AI_REQUEST_TIMEOUT_MS=30000

# Local service command:
# uv run uvicorn app.main:app --reload --host 0.0.0.0 --port 8000

# Required when AI_PROVIDER_MODE=openai or EMBEDDING_PROVIDER_MODE=openai.
OPENAI_API_KEY=
OPENAI_MODEL=

# Required when AI_PROVIDER_MODE=gemini_dev or EMBEDDING_PROVIDER_MODE=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=

# Required only when AI_PROVIDER_MODE=openrouter.
OPEN_ROUTER_API_KEY=
OPEN_ROUTER_MODEL=

# Static-image provider configuration (separate from text generation).
# Supported values: mock, openai, gemini, openrouter, unavailable.
# PRODUCTION: IMAGE_PROVIDER_MODE=openrouter + IMAGE_MODEL=google/gemini-3.1-flash-image
# (Gemini flash-image via OpenRouter, fixed 1024x1024 — every image costs the
# same, which is what makes the flat 8-point price honest). The mock default is
# development-only; do not run the mock in production.
IMAGE_PROVIDER_MODE=mock
IMAGE_MODEL=google/gemini-3.1-flash-image
IMAGE_REQUEST_TIMEOUT_MS=120000
# Powered via OpenRouter when IMAGE_PROVIDER_MODE=openrouter AND OPEN_ROUTER_API_KEY is set.
# Example paid model: google/gemini-3.1-flash-image (Nano Banana 2). 1024x1024 only.
#
# Required for a real image provider (openai | gemini | openrouter). Use a
# durable/shared mounted path. For direct Gemini use an image-capable model such
# as IMAGE_MODEL=gemini-3.1-flash-image (1024x1024 in the Content workflow).
CONTENT_ASSET_STORAGE_DIR=

# Content asset storage backend (filesystem | r2 | unavailable). When r2 is
# selected, apps/api must use the same bucket credentials so its worker and
# asset-read endpoints can verify and serve these objects.
ASSET_STORAGE_PROVIDER=filesystem
# Required when ASSET_STORAGE_PROVIDER=r2. Keys live in services/ai/.env.
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_USE_PATH_STYLE_ENDPOINT=true

# Embedding provider configuration
# Supported values: fake, openai, gemini.
# Default production model is text-embedding-3-large (3072 dims).
# Use text-embedding-3-small (1536 dims) for faster/cheaper local development.
EMBEDDING_PROVIDER_MODE=fake
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
EMBEDDING_BATCH_SIZE=32
EMBEDDING_REQUEST_TIMEOUT_MS=60000

# Retrieval selection. `semantic` is the existing score-ordered behavior.
# `semantic_mmr` is the default selection mode. Set `semantic` only for an
# explicit score-ordered rollback. Lambda balances relevance (1.0) and diversity (0.0).
RAG_SELECTION_MODE=semantic_mmr
RAG_MMR_LAMBDA=0.5

# For Gemini embeddings:
# EMBEDDING_PROVIDER_MODE=gemini
# EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_DIMENSIONS=768
# GEMINI_API_KEY=your-gemini-api-key

# Qdrant vector database configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=marketing_knowledge_v1
QDRANT_API_KEY=
QDRANT_TIMEOUT_MS=10000
QDRANT_USE_GRPC=false

# PostgreSQL (schema owned by apps/api; FastAI reads/writes these tables directly)
# Same DATABASE_URL used by the NestJS API. Required for the knowledge CLI.
DATABASE_URL=postgresql://marketmind:marketmind_dev@localhost:5433/marketmind_dev?schema=public

# ---------------------------------------------------------------------------
# Knowledge ingestion CLI (issue #71)
# Commands:
#   uv run python -m app.knowledge.ingestion.cli db-ready
#   uv run python -m app.knowledge.ingestion.cli dry-run
#   uv run python -m app.knowledge.ingestion.cli ingest --commit-sha $(git rev-parse HEAD)
#   uv run python -m app.knowledge.ingestion.cli rebuild
# ---------------------------------------------------------------------------

# CLI authentication token. Required for all commands above.
# Generate a secure random string for any non-local environment.
KNOWLEDGE_INTERNAL_CLI_TOKEN=change-me-to-a-secure-random-token

# Path to the curated Markdown corpus, relative to the repo root.
KNOWLEDGE_SOURCE_DIR=Docs/marketing-knowledge

# Chunking configuration (tokens).
KNOWLEDGE_CHUNK_MIN_TOKENS=300
KNOWLEDGE_CHUNK_MAX_TOKENS=500
KNOWLEDGE_CHUNK_OVERLAP_TOKENS=50

# When true, unresolved source_references fail the run before any DB/Qdrant writes.
KNOWLEDGE_STRICT_SOURCES=true

# ---------- Discovery Voice Notes (Issue #169) ----------
VOICE_TRANSCRIPTION_ENABLED=true
VOICE_TRANSCRIPTION_INTERNAL_TOKEN=change-me-to-a-secure-internal-token
VOICE_TRANSCRIPTION_MODEL=gemini-3.6-flash
VOICE_TRANSCRIPTION_TIMEOUT_MS=30000
VOICE_TRANSCRIPTION_MAX_BYTES=5242880
VOICE_TRANSCRIPTION_MAX_SECONDS=45
VOICE_TRANSCRIPTION_RATE_LIMIT_PER_MINUTE=4
