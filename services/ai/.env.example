# Copy this file to services/ai/.env and fill in your own keys.
# DO NOT commit .env — it is gitignored and meant for secrets.

# Supported values: mock, openai, gemini_dev, openrouter.
AI_PROVIDER_MODE=mock
AI_REQUEST_TIMEOUT_MS=30000

# Local service command:
# uv run uvicorn app.main:app --reload --host 0.0.0.0 --port 8000

# Required when AI_PROVIDER_MODE=openai or EMBEDDING_PROVIDER_MODE=openai.
OPENAI_API_KEY=
OPENAI_MODEL=

# Required when AI_PROVIDER_MODE=gemini_dev or EMBEDDING_PROVIDER_MODE=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=

# Required only when AI_PROVIDER_MODE=openrouter.
OPEN_ROUTER_API_KEY=
OPEN_ROUTER_MODEL=

# Static-image provider configuration (separate from text generation).
# Supported values: mock, openai, unavailable.
IMAGE_PROVIDER_MODE=mock
IMAGE_MODEL=gpt-image-1
IMAGE_REQUEST_TIMEOUT_MS=120000

# Embedding provider configuration
# Supported values: fake, openai, gemini.
# Default production model is text-embedding-3-large (3072 dims).
# Use text-embedding-3-small (1536 dims) for faster/cheaper local development.
EMBEDDING_PROVIDER_MODE=fake
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
EMBEDDING_BATCH_SIZE=32
EMBEDDING_REQUEST_TIMEOUT_MS=60000

# For Gemini embeddings:
# EMBEDDING_PROVIDER_MODE=gemini
# EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_DIMENSIONS=768
# GEMINI_API_KEY=your-gemini-api-key

# Qdrant vector database configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=marketing_knowledge_v1
QDRANT_API_KEY=
QDRANT_TIMEOUT_MS=10000
QDRANT_USE_GRPC=false

# PostgreSQL (schema owned by apps/api; FastAI reads/writes these tables directly)
# Same DATABASE_URL used by the NestJS API. Required for the knowledge CLI.
DATABASE_URL=postgresql://marketmind:marketmind_dev@localhost:5433/marketmind_dev?schema=public

# ---------------------------------------------------------------------------
# Knowledge ingestion CLI (issue #71)
# Commands:
#   uv run python -m app.knowledge.ingestion.cli db-ready
#   uv run python -m app.knowledge.ingestion.cli dry-run
#   uv run python -m app.knowledge.ingestion.cli ingest --commit-sha $(git rev-parse HEAD)
#   uv run python -m app.knowledge.ingestion.cli rebuild
# ---------------------------------------------------------------------------

# CLI authentication token. Required for all commands above.
# Generate a secure random string for any non-local environment.
KNOWLEDGE_INTERNAL_CLI_TOKEN=change-me-to-a-secure-random-token

# Path to the curated Markdown corpus, relative to the repo root.
KNOWLEDGE_SOURCE_DIR=Docs/marketing-knowledge

# Chunking configuration (tokens).
KNOWLEDGE_CHUNK_MIN_TOKENS=300
KNOWLEDGE_CHUNK_MAX_TOKENS=500
KNOWLEDGE_CHUNK_OVERLAP_TOKENS=50

# When true, unresolved source_references fail the run before any DB/Qdrant writes.
KNOWLEDGE_STRICT_SOURCES=true
