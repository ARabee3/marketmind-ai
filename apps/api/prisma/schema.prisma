  weekPlan               ContentWeekPlan?       @relation(fields: [weekPlanId], references: [id], onDelete: SetNull)
  business               Business               @relation(fields: [businessId], references: [id])
  businessProfileVersion BusinessProfileVersion @relation(fields: [profileVersionId], references: [id])
  items                  ContentItem[]
  itemVersions           ContentItemVersion[]
  progressEvents         ContentProgressEvent[]
  generationRuns         ContentGenerationRun[]
  publicationCandidates  PublicationCandidate[]

  @@unique([contentCycleId, weekNumber])
  @@index([contentCycleId])
  @@index([status])
  @@map("content_packs")
}

model ContentItem {
  id               String   @id @default(uuid()) @db.Uuid
  contentPackId    String   @map("content_pack_id") @db.Uuid
  currentVersionId String?  @map("current_version_id") @db.Uuid
  status           String   @default("draft")
  createdAt        DateTime @default(now()) @map("created_at")

  contentPack ContentPack          @relation(fields: [contentPackId], references: [id], onDelete: Cascade)
