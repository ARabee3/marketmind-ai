generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  DEVELOPER_DEMO
}

enum ActionTokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  password        String
  roles           Role[]    @default([OWNER])
  isEmailVerified Boolean   @default(false)
  refreshToken    String?
  lastLoginAt     DateTime?
  fullName        String?
  status          String    @default("active")
  preferredLocale String    @default("ar-EG")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  businesses                   Business[]
  socialConnections            SocialConnection[]
  discoverySessions            DiscoverySession[]
  refreshSessions              RefreshSession[]
  userRoles                    UserRole[]
  confirmedProfileVersions     BusinessProfileVersion[]
  actionTokens                 ActionToken[]
  federatedIdentities          FederatedIdentity[]
  strategies                   Strategy[]
  strategyDecisions            StrategyDecision[]
  contentCycles                ContentCycle[]
  decidedContentDecisions      ContentDecision[]            @relation("ContentDecisionDecidedBy")
  ownedContentDecisions        ContentDecision[]            @relation("ContentDecisionOwner")
  contentWeekContextsConfirmed ContentWeekContext[]
  contentMediaEntries          ContentMediaLibraryEntry[]
  publicationCandidateStatuses PublicationCandidateStatus[]
  orchestrationRuns            OrchestrationRun[]
  billingAccount               BillingAccount?
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address") @db.Inet
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model RoleEntity {
  id          String   @id @default(uuid()) @db.Uuid
  name        Role     @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       RoleEntity @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role RoleEntity @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Business {
  id            String   @id @default(uuid()) @db.Uuid
  ownerUserId   String   @map("owner_user_id") @db.Uuid
  displayName   String   @map("display_name")
  businessType  String   @map("business_type")
  city          String
  area          String?
  addressText   String?  @map("address_text")
  latitude      Decimal? @db.Decimal(9, 6)
  longitude     Decimal? @db.Decimal(9, 6)
  primaryLocale String   @default("ar-EG") @map("primary_locale")
  status        String   @default("draft")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  ownerUser               User                           @relation(fields: [ownerUserId], references: [id])
  discoverySessions       DiscoverySession[]
  socialLinks             SocialLink[]
  businessProfileDrafts   BusinessProfileDraft[]
  businessProfileVersions BusinessProfileVersion[]
  strategies              Strategy[]
  contentCycles           ContentCycle[]
  contentPacks            ContentPack[]
  contentMediaEntries     ContentMediaLibraryEntry[]
  publicationCandidates   PublicationCandidate[]
  orchestrationRuns       OrchestrationRun[]
  billingAccounts         BillingAccount[]
  publishingCredentials   PublishingCredential[]
  providerConnections     PublishingProviderConnection[]
  connectionAudits        PublishingConnectionAudit[]
  metaOAuthStates         MetaOAuthState[]

  @@index([ownerUserId])
  @@index([city, area])
  @@map("businesses")
}

// ── Billing / subscriptions ─────────────────────────────────────────────
// Payments are deterministic infrastructure. Provider payloads are kept at
// the adapter/event boundary; this local state is the entitlement source of
// truth. Amounts are whole Egyptian pounds for the launch catalog.

model BillingAccount {
  id               String   @id @default(uuid()) @db.Uuid
  ownerUserId      String   @unique @map("owner_user_id") @db.Uuid
  activeBusinessId String?  @map("active_business_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  ownerUser      User                        @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  activeBusiness Business?                   @relation(fields: [activeBusinessId], references: [id], onDelete: SetNull)
  subscriptions BillingSubscription[]
  checkouts      BillingCheckoutAttempt[]
  transactions   BillingPaymentTransaction[]
  providerEvents BillingProviderEvent[]
  usageLedger    BillingUsageLedger[]
  costLedger     BillingProviderCostLedger[]
  pointBalances  BillingPointBalance[]
  pointLedger    BillingPointLedger[]
  outbox         BillingOutbox[]

  @@index([activeBusinessId])
  @@map("billing_accounts")
}

/**
 * The spendable prepaid points balance for one account. The running sum of
 * the append-only BillingPointLedger; never modified outside a ledger
 * transaction.
 */
model BillingPointBalance {
  id               String   @id @default(uuid()) @db.Uuid
  billingAccountId String   @unique @map("billing_account_id") @db.Uuid
  balance          Int      @default(0)
  lifetimeGranted  Int      @default(0) @map("lifetime_granted")
  lifetimeSpent    Int      @default(0) @map("lifetime_spent")
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdAt        DateTime @default(now()) @map("created_at")

  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@map("billing_point_balances")
}

/**
 * Append-only points ledger. Balance is the running sum; a claim key makes
 * debits, credits, and refunds idempotent so queue replays and duplicate
 * webhooks never double-charge or double-grant.
 */
model BillingPointLedger {
  id               String    @id @default(uuid()) @db.Uuid
  billingAccountId String    @map("billing_account_id") @db.Uuid
  direction        String    // "credit" | "debit"
  reason           String    // "topup" | "trial_grant" | "spend" | "refund"
  metric           String?   // action metric for spends
  points           Int       // positive magnitude
  balanceAfter     Int       @map("balance_after")
  claimKey         String    @map("claim_key") // idempotency key
  transactionId    String?   @map("transaction_id") @db.Uuid // for top-ups
  expiresAt        DateTime? @map("expires_at") // for credits (rollover/expiry)
  createdAt        DateTime  @default(now()) @map("created_at")

  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@unique([billingAccountId, claimKey])
  @@index([billingAccountId, createdAt])
  @@map("billing_point_ledger")
}

model BillingPrice {
  id            String    @id @default(uuid()) @db.Uuid
  code          String    @unique
  planCode      String    @map("plan_code")
  interval      String
  amountEgp     Int       @map("amount_egp")
  currency      String    @default("EGP")
  periodDays    Int       @map("period_days")
  pointsGranted Int?      @map("points_granted")
  public        Boolean   @default(true)
  displayNameEn String    @map("display_name_en")
  displayNameAr String    @map("display_name_ar")
  entitlements  Json      @default("{}")
  activeFrom    DateTime  @default(now()) @map("active_from")
  retiredAt     DateTime? @map("retired_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  subscriptions BillingSubscription[]
  checkouts     BillingCheckoutAttempt[]

  @@index([planCode, public, retiredAt])
  @@map("billing_prices")
}

model BillingSubscription {
  id                   String    @id @default(uuid()) @db.Uuid
  billingAccountId     String    @map("billing_account_id") @db.Uuid
  priceId              String    @map("price_id") @db.Uuid
  state                String    @default("trialing")
  renewalMode          String    @default("none") @map("renewal_mode")
  provider             String?
  providerCustomerRef  String?   @map("provider_customer_ref")
  providerAgreementRef String?   @map("provider_agreement_ref")
  maskedPaymentMethod  String?   @map("masked_payment_method")
  trialStartedAt       DateTime? @map("trial_started_at")
  trialEndsAt          DateTime? @map("trial_ends_at")
  paidThroughAt        DateTime? @map("paid_through_at")
  graceEndsAt          DateTime? @map("grace_ends_at")
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  cancelRequestedAt    DateTime? @map("cancel_requested_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  billingAccount BillingAccount              @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  price          BillingPrice                @relation(fields: [priceId], references: [id])
  transactions   BillingPaymentTransaction[]

  @@index([billingAccountId, state, createdAt])
  @@index([paidThroughAt])
  @@map("billing_subscriptions")
}

model BillingCheckoutAttempt {
  id                  String    @id @default(uuid()) @db.Uuid
  billingAccountId    String    @map("billing_account_id") @db.Uuid
  priceId             String    @map("price_id") @db.Uuid
  idempotencyKey      String    @map("idempotency_key")
  requestFingerprint  String    @map("request_fingerprint")
  provider            String
  providerCheckoutRef String?   @unique @map("provider_checkout_ref")
  providerCheckoutUrl String?   @map("provider_checkout_url")
  amountEgp           Int       @map("amount_egp")
  currency            String    @default("EGP")
  paymentMode         String    @map("payment_mode")
  sandbox             Boolean   @default(false)
  status              String    @default("pending")
  expiresAt           DateTime  @map("expires_at")
  confirmedAt         DateTime? @map("confirmed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  billingAccount BillingAccount              @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  price          BillingPrice                @relation(fields: [priceId], references: [id])
  transactions   BillingPaymentTransaction[]

  @@unique([billingAccountId, idempotencyKey])
  @@index([billingAccountId, status])
  @@index([expiresAt, status])
  @@map("billing_checkout_attempts")
}

model BillingPaymentTransaction {
  id                    String   @id @default(uuid()) @db.Uuid
  billingAccountId      String   @map("billing_account_id") @db.Uuid
  subscriptionId        String?  @map("subscription_id") @db.Uuid
  checkoutAttemptId     String?  @map("checkout_attempt_id") @db.Uuid
  provider              String
  providerTransactionId String   @map("provider_transaction_id")
  kind                  String
  status                String
  amountEgp             Int      @map("amount_egp")
  currency              String   @default("EGP")
  paymentMode           String?  @map("payment_mode")
  occurredAt            DateTime @map("occurred_at")
  createdAt             DateTime @default(now()) @map("created_at")

  billingAccount BillingAccount          @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)
  subscription   BillingSubscription?    @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  checkout       BillingCheckoutAttempt? @relation(fields: [checkoutAttemptId], references: [id], onDelete: SetNull)

  @@unique([provider, providerTransactionId])
  @@index([billingAccountId, occurredAt])
  @@map("billing_payment_transactions")
}

model BillingProviderEvent {
  id               String    @id @default(uuid()) @db.Uuid
  billingAccountId String?   @map("billing_account_id") @db.Uuid
  provider         String
  externalEventId  String    @map("external_event_id")
  fingerprint      String
  eventType        String    @map("event_type")
  signatureValid   Boolean   @map("signature_valid")
  status           String    @default("received")
  payload          Json      @default("{}")
  receivedAt       DateTime  @default(now()) @map("received_at")
  processedAt      DateTime? @map("processed_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  billingAccount BillingAccount? @relation(fields: [billingAccountId], references: [id], onDelete: SetNull)

  @@unique([provider, externalEventId])
  @@index([fingerprint])
  @@index([status, receivedAt])
  @@map("billing_provider_events")
}

model BillingUsageLedger {
  id               String   @id @default(uuid()) @db.Uuid
  billingAccountId String   @map("billing_account_id") @db.Uuid
  businessId       String?  @map("business_id") @db.Uuid
  metric           String
  periodStart      DateTime @map("period_start")
  periodEnd        DateTime @map("period_end")
  units            Int      @default(0)
  claimKey         String   @map("claim_key")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@unique([billingAccountId, metric, periodStart, claimKey])
  @@index([billingAccountId, metric, periodStart, periodEnd])
  @@map("billing_usage_ledger")
}

model BillingProviderCostLedger {
  id                 String   @id @default(uuid()) @db.Uuid
  billingAccountId   String   @map("billing_account_id") @db.Uuid
  businessId         String?  @map("business_id") @db.Uuid
  billingPeriodStart DateTime @map("billing_period_start")
  provider           String
  model              String?
  logicalArtifactKey String   @map("logical_artifact_key")
  inputUnits         Int?     @map("input_units")
  outputUnits        Int?     @map("output_units")
  nativeCost         Decimal? @map("native_cost") @db.Decimal(18, 8)
  nativeCurrency     String?  @map("native_currency")
  egpRate            Decimal? @map("egp_rate") @db.Decimal(18, 8)
  egpCost            Decimal? @map("egp_cost") @db.Decimal(18, 8)
  successfulArtifact Boolean  @default(false) @map("successful_artifact")
  quotaEffect        Int      @default(0) @map("quota_effect")
  retryCount         Int      @default(0) @map("retry_count")
  snapshotVersion    String   @map("snapshot_version")
  createdAt          DateTime @default(now()) @map("created_at")

  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@unique([billingAccountId, logicalArtifactKey])
  @@index([billingAccountId, billingPeriodStart])
  @@map("billing_provider_cost_ledger")
}

model BillingOutbox {
  id               String    @id @default(uuid()) @db.Uuid
  billingAccountId String    @map("billing_account_id") @db.Uuid
  eventType        String    @map("event_type")
  dedupeKey        String    @unique @map("dedupe_key")
  payload          Json      @default("{}")
  dispatchedAt     DateTime? @map("dispatched_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@index([dispatchedAt, createdAt])
  @@map("billing_outbox")
}

model DiscoverySession {
  id                        String    @id @default(uuid()) @db.Uuid
  businessId                String?   @map("business_id") @db.Uuid
  ownerUserId               String    @map("owner_user_id") @db.Uuid
  status                    String
  languageMode              String    @default("mixed") @map("language_mode")
  currentQuestion           String?   @map("current_question")
  profileState              Json      @default("{}") @map("profile_state")
  ownerTurnCount            Int       @default(0) @map("owner_turn_count")
  completionReason          String?   @map("completion_reason")
  profileDraftId            String?   @map("profile_draft_id") @db.Uuid
  confirmedProfileVersionId String?   @map("confirmed_profile_version_id") @db.Uuid
  startedAt                 DateTime  @default(now()) @map("started_at")
  completedAt               DateTime? @map("completed_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  business                Business?                 @relation(fields: [businessId], references: [id])
  ownerUser               User                      @relation(fields: [ownerUserId], references: [id])
  intakes                 PreparedDiscoveryIntake[]
  socialLinks             SocialLink[]
  intelligenceRuns        IntelligenceRun[]
  sourceRefs              SourceRef[]
  researchObservations    ResearchObservation[]
  conversationHooks       ConversationHook[]
  knowledgeGaps           KnowledgeGap[]
  discoveryMessages       DiscoveryMessage[]
  businessProfileDrafts   BusinessProfileDraft[]
  agentRuns               AgentRun[]
  discoveryProgressEvents DiscoveryProgressEvent[]

  @@index([ownerUserId, status])
  @@index([businessId])
  @@index([createdAt])
  @@map("discovery_sessions")
}

model PreparedDiscoveryIntake {
  id                   String   @id @default(uuid()) @db.Uuid
  sessionId            String   @unique @map("session_id") @db.Uuid
  businessName         String   @map("business_name")
  businessType         String   @map("business_type")
  city                 String
  area                 String?
  addressText          String?  @map("address_text")
  ownerGoalText        String?  @map("owner_goal_text")
  knownCompetitorsText String?  @map("known_competitors_text")
  targetAudienceText   String?  @map("target_audience_text")
  notes                String?
  rawPayload           Json     @default("{}") @map("raw_payload")
  createdAt            DateTime @default(now()) @map("created_at")

  session DiscoverySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("prepared_discovery_intakes")
}

model SocialLink {
  id             String   @id @default(uuid()) @db.Uuid
  sessionId      String   @map("session_id") @db.Uuid
  businessId     String?  @map("business_id") @db.Uuid
  platform       String
  url            String
  ownerSubmitted Boolean  @default(true) @map("owner_submitted")
  status         String   @default("pending")
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  session  DiscoverySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  business Business?        @relation(fields: [businessId], references: [id])

  @@unique([sessionId, url])
  @@index([sessionId, platform])
  @@map("social_links")
}

/// One connected social account per user (dev milestone: Facebook Page only).
/// The Page access token is reversible-encrypted (AES-256-GCM) — never hashed —
/// because the raw token is required for Graph API publish calls.
model SocialConnection {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @map("user_id") @db.Uuid
  provider       String    @default("facebook")
  pageId         String    @map("page_id")
  pageName       String    @map("page_name")
  encryptedToken String    @map("encrypted_token")
  encryptionIv   String    @map("encryption_iv")
  authTag        String    @map("auth_tag")
  isValid        Boolean   @default(true) @map("is_valid")
  connectedAt    DateTime  @default(now()) @map("connected_at")
  lastTestedAt   DateTime? @map("last_tested_at")
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("social_connections")
}

model IntelligenceRun {
  id           String    @id @default(uuid()) @db.Uuid
  sessionId    String    @map("session_id") @db.Uuid
  status       String
  searchMode   String    @map("search_mode")
  startedAt    DateTime  @default(now()) @map("started_at")
  completedAt  DateTime? @map("completed_at")
  durationMs   Int?      @map("duration_ms")
  errorCode    String?   @map("error_code")
  errorMessage String?   @map("error_message")
  createdAt    DateTime  @default(now()) @map("created_at")

  session    DiscoverySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sourceRefs SourceRef[]

  @@index([sessionId])
  @@index([status])
  @@map("intelligence_runs")
}

model SourceRef {
  id                String    @id @default(uuid()) @db.Uuid
  sessionId         String    @map("session_id") @db.Uuid
  intelligenceRunId String?   @map("intelligence_run_id") @db.Uuid
  sourceType        String    @map("source_type")
  platform          String?
  url               String?
  title             String?
  snippet           String?
  fetchedAt         DateTime? @map("fetched_at")
  confidence        Decimal   @default(0.5) @db.Decimal(4, 3)
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at")

  session              DiscoverySession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  intelligenceRun      IntelligenceRun?      @relation(fields: [intelligenceRunId], references: [id], onDelete: SetNull)
  researchObservations ResearchObservation[]

  @@index([sessionId])
  @@index([confidence])
  @@index([url])
  @@map("source_refs")
}

model ResearchObservation {
  id            String   @id @default(uuid()) @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid
  sourceRefId   String?  @map("source_ref_id") @db.Uuid
  kind          String
  statement     String
  confidence    Decimal  @default(0.5) @db.Decimal(4, 3)
  visibility    String   @default("internal")
  status        String   @default("accepted")
  discardReason String?  @map("discard_reason")
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")

  session   DiscoverySession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sourceRef SourceRef?         @relation(fields: [sourceRefId], references: [id], onDelete: SetNull)
  hooks     ConversationHook[]

  @@index([sessionId, status])
  @@index([kind])
  @@map("research_observations")
}

model ConversationHook {
  id                  String   @id @default(uuid()) @db.Uuid
  sessionId           String   @map("session_id") @db.Uuid
  sourceObservationId String?  @map("source_observation_id") @db.Uuid
  hookText            String   @map("hook_text")
  language            String   @default("mixed")
  status              String   @default("active")
  createdAt           DateTime @default(now()) @map("created_at")

  session           DiscoverySession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sourceObservation ResearchObservation? @relation(fields: [sourceObservationId], references: [id], onDelete: SetNull)

  @@index([sessionId, status])
  @@map("conversation_hooks")
}

model KnowledgeGap {
  id           String   @id @default(uuid()) @db.Uuid
  sessionId    String   @map("session_id") @db.Uuid
  fieldKey     String   @map("field_key")
  questionHint String   @map("question_hint")
  priority     Int      @default(3)
  status       String   @default("open")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  session DiscoverySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status, priority])
  @@map("knowledge_gaps")
}

model DiscoveryMessage {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  role      String
  content   String
  language  String   @default("mixed")
  source    String   @default("chat")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  session DiscoverySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("discovery_messages")
}

model BusinessProfileDraft {
  id                    String   @id @default(uuid()) @db.Uuid
  sessionId             String   @map("session_id") @db.Uuid
  businessId            String?  @map("business_id") @db.Uuid
  version               Int      @default(1)
  status                String   @default("draft")
  completeness          String   @default("incomplete")
  completionReason      String   @default("owner_finished_early") @map("completion_reason")
  readiness             Json     @default("{}")
  confirmedFacts        Json     @default("{}") @map("confirmed_facts")
  researchObservations  Json     @default("[]") @map("research_observations")
  uncertainties         Json     @default("[]")
  ownerGoals            Json     @default("[]") @map("owner_goals")
  strategyRelevantNotes Json     @default("[]") @map("strategy_relevant_notes")
  rawAiOutput           Json     @default("{}") @map("raw_ai_output")
  createdByAgentRunId   String?  @map("created_by_agent_run_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  session        DiscoverySession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  business       Business?                @relation(fields: [businessId], references: [id])
  createdByAgent AgentRun?                @relation("AgentRunDrafts", fields: [createdByAgentRunId], references: [id], onDelete: SetNull)
  versions       BusinessProfileVersion[]

  @@unique([sessionId, version])
  @@index([sessionId, status])
  @@map("business_profile_drafts")
}

model BusinessProfileVersion {
  id                String   @id @default(uuid()) @db.Uuid
  businessId        String   @map("business_id") @db.Uuid
  draftId           String?  @map("draft_id") @db.Uuid
  version           Int
  profile           Json
  confirmedByUserId String   @map("confirmed_by_user_id") @db.Uuid
  confirmedAt       DateTime @default(now()) @map("confirmed_at")
  createdAt         DateTime @default(now()) @map("created_at")

  business        Business               @relation(fields: [businessId], references: [id])
  draft           BusinessProfileDraft?  @relation(fields: [draftId], references: [id], onDelete: SetNull)
  confirmedByUser User                   @relation(fields: [confirmedByUserId], references: [id])
  strategyBriefs  StrategyBrief[]
  retrievalRuns   StrategyRetrievalRun[]
  contentCycles   ContentCycle[]
  contentPacks    ContentPack[]

  @@unique([businessId, version])
  @@index([businessId])
  @@map("business_profile_versions")
}

model AgentRun {
  id            String   @id @default(uuid()) @db.Uuid
  sessionId     String?  @map("session_id") @db.Uuid
  runType       String   @map("run_type")
  providerMode  String   @map("provider_mode")
  modelName     String?  @map("model_name")
  promptVersion String   @map("prompt_version")
  status        String
  inputHash     String?  @map("input_hash")
  inputTokens   Int?     @map("input_tokens")
  outputTokens  Int?     @map("output_tokens")
  latencyMs     Int?     @map("latency_ms")
  outputJson    Json     @default("{}") @map("output_json")
  errorCode     String?  @map("error_code")
  errorMessage  String?  @map("error_message")
  createdAt     DateTime @default(now()) @map("created_at")

  session       DiscoverySession?      @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  profileDrafts BusinessProfileDraft[] @relation("AgentRunDrafts")

  @@index([sessionId])
  @@index([runType, status])
  @@index([createdAt])
  @@map("agent_runs")
}

// Generic durable orchestration state. Domain rows remain authoritative;
// this pair only records the run envelope, checkpoint references, and a
// sanitized ordered event stream owned by the orchestration boundary.
model OrchestrationRun {
  id                     String   @id @default(uuid()) @db.Uuid
  businessId             String   @map("business_id") @db.Uuid
  ownerUserId            String   @map("owner_user_id") @db.Uuid
  contractVersion        String   @map("contract_version")
  graphName              String   @map("graph_name")
  graphVersion           String   @map("graph_version")
  status                 String
  currentRole            String?  @map("current_role")
  currentStage           String   @map("current_stage")
  featureCohort          String   @map("feature_cohort")
  checkpointThreadId     String   @unique @map("checkpoint_thread_id")
  checkpointVersion      Int?     @map("checkpoint_version")
  immutableInputRefs     Json     @default("{}") @map("immutable_input_refs")
  outputRefs             Json     @default("{}") @map("output_refs")
  bounds                 Json     @default("{}")
  correlationId          String   @map("correlation_id")
  idempotencyKey         String   @map("idempotency_key")
  idempotencyFingerprint String   @map("idempotency_fingerprint")
  terminalError          Json?    @map("terminal_error")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  business  Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ownerUser User                 @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  events    OrchestrationEvent[]

  @@unique([ownerUserId, idempotencyKey])
  @@index([businessId, status])
  @@index([ownerUserId, status])
  @@map("orchestration_runs")
}

model OrchestrationEvent {
  id              String   @id @default(uuid()) @db.Uuid
  runId           String   @map("run_id") @db.Uuid
  seq             Int
  contractVersion String   @map("contract_version")
  eventType       String   @map("event_type")
  status          String
  currentRole     String?  @map("current_role")
  currentStage    String   @map("current_stage")
  node            String?
  tool            String?
  summary         String
  payload         Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")

  run OrchestrationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, seq])
  @@index([runId, createdAt])
  @@map("orchestration_events")
}

model DiscoveryProgressEvent {
  id          BigInt   @id @default(autoincrement())
  sessionId   String   @map("session_id") @db.Uuid
  seq         Int
  stage       String
  status      String
  messageKey  String   @map("message_key")
  messageText String   @map("message_text")
  payload     Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  session DiscoverySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, seq])
  @@index([sessionId, createdAt])
  @@map("discovery_progress_events")
}

// ── Action Tokens ─────────────────────────────────────────────────────
// One-time tokens for password reset, email verification, etc.
// Raw tokens are NEVER stored — only SHA-256 hashes.

model ActionToken {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  type       ActionTokenType
  tokenHash  String          @unique @map("token_hash")
  expiresAt  DateTime        @map("expires_at")
  consumedAt DateTime?       @map("consumed_at")
  createdAt  DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("action_tokens")
}

// ── Federated Identity (Google, future providers) ─────────────────────
// Links external OAuth identities to local user accounts.

model FederatedIdentity {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  provider        String
  providerSubject String   @map("provider_subject")
  email           String?
  displayName     String?  @map("display_name")
  avatarUrl       String?  @map("avatar_url")
  rawProfile      Json     @default("{}") @map("raw_profile")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("federated_identities")
}

// ── Marketing Knowledge Governance ─────────────────────────────────────
// Authoritative, versioned, auditable store for the curated RAG knowledge
// library. Qdrant (see services/ai/app/qdrant) is a rebuildable derived
// index over MarketingKnowledgeChunk rows — never the other way around.
// This schema is shared-knowledge only: no Business Profile data here.

model MarketingKnowledgeEntry {
  id            String   @id @default(uuid()) @db.Uuid
  slug          String   @unique
  latestVersion Int      @default(0) @map("latest_version")
  createdAt     DateTime @default(now()) @map("created_at")

  versions MarketingKnowledgeEntryVersion[]

  @@map("marketing_knowledge_entries")
}

model MarketingKnowledgeEntryVersion {
  id             String    @id @default(uuid()) @db.Uuid
  entryId        String    @map("entry_id") @db.Uuid
  version        Int
  kind           String
  title          String
  titleAr        String?   @map("title_ar")
  summary        String
  body           String    @db.Text
  locale         String
  markets        String[]
  industries     String[]
  businessModels String[]  @map("business_models")
  objectives     String[]
  funnelStages   String[]  @map("funnel_stages")
  channels       String[]
  seasons        String[]
  budgetModes    String[]  @map("budget_modes")
  evidenceTier   String    @map("evidence_tier")
  reviewStatus   String    @default("draft") @map("review_status")
  effectiveAt    DateTime  @map("effective_at")
  expiresAt      DateTime? @map("expires_at")
  author         String
  reviewer       String?
  reviewedAt     DateTime? @map("reviewed_at")
  checksum       String
  createdAt      DateTime  @default(now()) @map("created_at")

  entry   MarketingKnowledgeEntry       @relation(fields: [entryId], references: [id], onDelete: Cascade)
  sources MarketingKnowledgeSourceRef[]
  chunks  MarketingKnowledgeChunk[]

  @@unique([entryId, version])
  @@index([reviewStatus, effectiveAt, expiresAt])
  @@index([kind])
  @@index([locale])
  @@index([evidenceTier])
  @@index([markets], type: Gin)
  @@index([industries], type: Gin)
  @@index([businessModels], type: Gin)
  @@index([objectives], type: Gin)
  @@index([funnelStages], type: Gin)
  @@index([channels], type: Gin)
  @@index([seasons], type: Gin)
  @@index([budgetModes], type: Gin)
  @@map("marketing_knowledge_entry_versions")
}

model MarketingKnowledgeSourceRef {
  id             String   @id @default(uuid()) @db.Uuid
  entryVersionId String   @map("entry_version_id") @db.Uuid
  reference      String
  note           String?
  createdAt      DateTime @default(now()) @map("created_at")

  entryVersion MarketingKnowledgeEntryVersion @relation(fields: [entryVersionId], references: [id], onDelete: Cascade)

  @@unique([entryVersionId, reference])
  @@index([entryVersionId])
  @@map("marketing_knowledge_source_refs")
}

// NOTE: id uses application-layer @default(uuid()). Revisit
// @default(dbgenerated("gen_random_uuid()")) here if #71's bulk
// ingestion benchmarks show round-trip overhead — see PR #94 review.
model MarketingKnowledgeChunk {
  id                   String    @id @default(uuid()) @db.Uuid
  chunkId              String    @unique @map("chunk_id") @db.Uuid
  entryVersionId       String    @map("entry_version_id") @db.Uuid
  chunkOrder           Int       @map("chunk_order")
  text                 String    @db.Text
  tokenCount           Int       @map("token_count")
  checksum             String
  embeddingProvider    String    @map("embedding_provider")
  embeddingModel       String    @map("embedding_model")
  embeddingDimensions  Int       @map("embedding_dimensions")
  embeddingVersion     String    @map("embedding_version")
  qdrantPointId        String?   @map("qdrant_point_id") @db.Uuid
  qdrantCollectionName String?   @map("qdrant_collection_name")
  indexedAt            DateTime? @map("indexed_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  entryVersion MarketingKnowledgeEntryVersion @relation(fields: [entryVersionId], references: [id], onDelete: Cascade)

  @@unique([entryVersionId, chunkOrder])
  @@unique([checksum, embeddingProvider, embeddingModel, embeddingDimensions, embeddingVersion], name: "chunk_idempotency_key")
  @@index([entryVersionId])
  @@index([chunkId])
  @@map("marketing_knowledge_chunks")
}

model MarketingKnowledgeIngestionRun {
  id            String    @id @default(uuid()) @db.Uuid
  status        String    @default("pending")
  actor         String
  commitSha     String?   @map("commit_sha")
  configuration Json      @default("{}")
  enteredCount  Int       @default(0) @map("entered_count")
  updatedCount  Int       @default(0) @map("updated_count")
  skippedCount  Int       @default(0) @map("skipped_count")
  failedCount   Int       @default(0) @map("failed_count")
  startedAt     DateTime  @default(now()) @map("started_at")
  finishedAt    DateTime? @map("finished_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  errors MarketingKnowledgeIngestionError[]

  @@index([status, startedAt])
  @@map("marketing_knowledge_ingestion_runs")
}

model MarketingKnowledgeIngestionError {
  id           String   @id @default(uuid()) @db.Uuid
  runId        String   @map("run_id") @db.Uuid
  slug         String?
  version      Int?
  errorCode    String   @map("error_code")
  errorMessage String   @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")

  run MarketingKnowledgeIngestionRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("marketing_knowledge_ingestion_errors")
}

model StrategyRetrievalRun {
  id               String    @id @default(uuid()) @db.Uuid
  strategyId       String    @map("strategy_id") @db.Uuid
  briefId          String    @map("brief_id") @db.Uuid
  profileVersionId String    @map("profile_version_id") @db.Uuid
  querySummary     String    @map("query_summary")
  queryContext     Json      @map("query_context")
  configuration    Json      @default("{}") @map("configuration")
  status           String    @default("pending") @map("status")
  itemCount        Int       @default(0) @map("item_count")
  gapCount         Int       @default(0) @map("gap_count")
  latencyMs        Int       @default(0) @map("latency_ms")
  startedAt        DateTime  @default(now()) @map("started_at")
  finishedAt       DateTime? @map("finished_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  items          StrategyRetrievalItem[]
  gaps           StrategyRetrievalGap[]
  strategy       Strategy                @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  brief          StrategyBrief           @relation(fields: [briefId], references: [id], onDelete: Cascade)
  profileVersion BusinessProfileVersion  @relation(fields: [profileVersionId], references: [id])

  @@index([strategyId, createdAt])
