model PublicationCandidate {
  id                   String   @id @default(uuid()) @db.Uuid
  candidateId          String   @unique @map("candidate_id") @db.Uuid
  businessId           String   @map("business_id") @db.Uuid
  contractVersion      String   @default("content-v1") @map("contract_version")
  payload              Json
  candidateChecksum    String   @map("candidate_checksum")
  contentCycleId       String   @map("content_cycle_id") @db.Uuid
  contentPackId        String   @map("content_pack_id") @db.Uuid
  contentItemId        String   @map("content_item_id") @db.Uuid
  contentItemVersionId String   @map("content_item_version_id") @db.Uuid
  contentItemVersion   Int      @map("content_item_version")
  state                String   @default("active")
  createdAt            DateTime @default(now()) @map("created_at")

  business     Business                     @relation(fields: [businessId], references: [id])
