}

model StrategyRetrievalItem {
  id               String    @id @default(uuid()) @db.Uuid
  runId            String    @map("run_id") @db.Uuid
  chunkId          String    @map("chunk_id") @db.Uuid
  entryId          String    @map("entry_id") @db.Uuid
  entryVersion     Int       @map("entry_version")
  title            String
  excerpt          String
  kind             String
  tags             Json      @default("{}") @map("tags")
  relevanceScore   Float     @map("relevance_score")
  evidenceTier     String    @map("evidence_tier")
  sourceReferences String[]  @map("source_references")
  effectiveAt      DateTime  @map("effective_at")
  expiresAt        DateTime? @map("expires_at")
  reviewStatus     String    @map("review_status")
  marketTier       String    @map("market_tier")
  isFallback       Boolean   @default(false) @map("is_fallback")
  fallbackLabel    String?   @map("fallback_label")
  category         String
  createdAt        DateTime  @default(now()) @map("created_at")

  run StrategyRetrievalRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([chunkId])
  @@map("strategy_retrieval_items")
}

model StrategyRetrievalGap {
  id          String @id @default(uuid()) @db.Uuid
  runId       String @map("run_id") @db.Uuid
  category    String
  description String
  severity    String

  run StrategyRetrievalRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("strategy_retrieval_gaps")
}

model Strategy {
  id              String   @id @default(uuid()) @db.Uuid
  businessId      String   @map("business_id") @db.Uuid
  status          String   @default("needs_brief")
  contractVersion String   @default("strategy-v1") @map("contract_version")
  currentVersionId String?  @map("current_version_id") @db.Uuid
  ownerUserId     String   @map("owner_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  business       Business                @relation(fields: [businessId], references: [id])
  ownerUser      User                    @relation(fields: [ownerUserId], references: [id])
  brief          StrategyBrief?
  versions       StrategyVersion[]
  retrievalRuns  StrategyRetrievalRun[]
  progressEvents StrategyProgressEvent[]

  @@index([businessId])
  @@index([ownerUserId])
  @@map("strategies")
}

model StrategyBrief {
  id                       String   @id @default(uuid()) @db.Uuid
  strategyId               String   @unique @map("strategy_id") @db.Uuid
  businessProfileVersionId String   @map("business_profile_version_id") @db.Uuid
  primaryObjective         String   @map("primary_objective")
  startDate                DateTime @map("start_date")
  planLanguage             String   @map("plan_language")
  paidMediaAllowed         Boolean  @map("paid_media_allowed")
  externalBudgetMode       String   @map("external_budget_mode")
  externalBudgetEgp        Json?    @map("external_budget_egp")
  teamCapacity             String?  @map("team_capacity")
  weeklyCapacity           String?  @map("weekly_capacity")
  weeklyCapacityNote       String?  @map("weekly_capacity_note")
  channelChoices           Json?    @map("channel_choices")
  constraints              String?
  clarificationAnswers     Json?    @map("clarification_answers")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  strategy               Strategy               @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  businessProfileVersion BusinessProfileVersion @relation(fields: [businessProfileVersionId], references: [id])
  retrievalRuns          StrategyRetrievalRun[]

  @@map("strategy_briefs")
}

model StrategyVersion {
  id             String   @id @default(uuid()) @db.Uuid
  strategyId     String   @map("strategy_id") @db.Uuid
  version        Int
  retrievalRunId String?  @map("retrieval_run_id") @db.Uuid
  promptConfig   Json     @default("{}") @map("prompt_config")
  planData       Json     @map("plan_data")
  createdAt      DateTime @default(now()) @map("created_at")

  strategy  Strategy           @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  decisions StrategyDecision[]

  @@unique([strategyId, version])
  @@map("strategy_versions")
}

model StrategyDecision {
  id                String   @id @default(uuid()) @db.Uuid
  strategyVersionId String   @map("strategy_version_id") @db.Uuid
  ownerUserId       String   @map("owner_user_id") @db.Uuid
  action            String
  feedback          String?
  createdAt         DateTime @default(now()) @map("created_at")

  strategyVersion StrategyVersion @relation(fields: [strategyVersionId], references: [id], onDelete: Cascade)
  ownerUser       User            @relation(fields: [ownerUserId], references: [id])

  @@map("strategy_decisions")
}

model StrategyProgressEvent {
  id          BigInt   @id @default(autoincrement())
  strategyId  String   @map("strategy_id") @db.Uuid
  seq         Int
  stage       String
  status      String
  messageKey  String   @map("message_key")
  messageText String   @map("message_text")
  payload     Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@unique([strategyId, seq])
  @@index([strategyId, createdAt])
  @@map("strategy_progress_events")
}

model ContentCycle {
  id                     String    @id @default(uuid()) @db.Uuid
  contractVersion        String    @default("content-v2") @map("contract_version")
  businessId             String    @map("business_id") @db.Uuid
  strategyId             String    @map("strategy_id") @db.Uuid
  strategyVersion        Int       @map("strategy_version")
  strategyDecisionId     String    @map("strategy_decision_id") @db.Uuid
  profileVersionId       String    @map("profile_version_id") @db.Uuid
  status                 String    @default("active")
  currentWeekNumber      Int       @default(1) @map("current_week_number")
  week1StartDate         DateTime  @map("week_1_start_date") @db.Date
  nextGenerationAt       DateTime? @map("next_generation_at")
  timezone               String    @default("Africa/Cairo")
  pauseReason            String?   @map("pause_reason")
  completedAt            DateTime? @map("completed_at")
  ownerUserId            String    @map("owner_user_id") @db.Uuid
  idempotencyKey         String?   @map("idempotency_key")
  idempotencyFingerprint String?   @map("idempotency_fingerprint")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  business              Business               @relation(fields: [businessId], references: [id])
  ownerUser             User                   @relation(fields: [ownerUserId], references: [id])
  profileVersion        BusinessProfileVersion @relation(fields: [profileVersionId], references: [id])
  weekContexts          ContentWeekContext[]
  packs                 ContentPack[]
  generationRuns        ContentGenerationRun[]
  publicationCandidates PublicationCandidate[]
  editorialProfile      ContentEditorialProfile?
  ctaLibraryEntries     ContentCtaLibraryEntry[]
  mediaEntries          ContentMediaLibraryEntry[]
  weekPlans             ContentWeekPlan[]

  @@unique([ownerUserId, idempotencyKey])
  @@index([businessId])
  @@index([strategyId, strategyVersion])
  @@map("content_cycles")
}

model ContentWeekContext {
  id                 String    @id @default(uuid()) @db.Uuid
  contractVersion    String    @default("content-v1") @map("contract_version")
  contentCycleId     String    @map("content_cycle_id") @db.Uuid
  weekNumber         Int       @map("week_number")
  weekStartDate      DateTime  @map("week_start_date") @db.Date
  promotionMode      String    @map("promotion_mode")
  promotion          Json?
  mustInclude        Json      @default("[]") @map("must_include")
  mustAvoid          Json      @default("[]") @map("must_avoid")
  approvedAssetIds   Json      @default("[]") @map("approved_asset_ids")
  ctaDestination     Json?     @map("cta_destination")
  generationCutoffAt DateTime  @map("generation_cutoff_at")
  weeklyClaimId      String    @map("weekly_claim_id") @db.Uuid
  contextSource      String    @map("context_source")
  confirmedByUserId  String?   @map("confirmed_by_user_id") @db.Uuid
  confirmedAt        DateTime? @map("confirmed_at")
  systemDefaultedAt  DateTime? @map("system_defaulted_at")
  frozenAt           DateTime? @map("frozen_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  contentCycle    ContentCycle  @relation(fields: [contentCycleId], references: [id], onDelete: Cascade)
  confirmedByUser User?         @relation(fields: [confirmedByUserId], references: [id])
  packs           ContentPack[]

  @@unique([contentCycleId, weekNumber])
  @@index([contentCycleId])
  @@map("content_week_contexts")
}

model ContentPack {
  id                 String   @id @default(uuid()) @db.Uuid
  contractVersion    String   @default("content-v1") @map("contract_version")
  contentCycleId     String   @map("content_cycle_id") @db.Uuid
  weeklyClaimId      String   @map("weekly_claim_id") @db.Uuid
  weekNumber         Int      @map("week_number")
  businessId         String   @map("business_id") @db.Uuid
  strategyId         String   @map("strategy_id") @db.Uuid
  strategyVersion    Int      @map("strategy_version")
  strategyDecisionId String   @map("strategy_decision_id") @db.Uuid
  profileVersionId   String   @map("profile_version_id") @db.Uuid
  weekContextId      String   @map("week_context_id") @db.Uuid
  status             String   @default("queued")
  retryEligible      Boolean  @default(true) @map("retry_eligible")
  itemIds            Json     @default("[]") @map("item_ids")
  weekPlanId         String?  @map("week_plan_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  contentCycle           ContentCycle           @relation(fields: [contentCycleId], references: [id], onDelete: Cascade)
