# Full URL of the NestJS API including the /api/v1 prefix.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Public origin used for canonical and alternate-language metadata in builds.
# Production overrides this to the deployed HTTPS host.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: explicit WebSocket gateway URL. Defaults to NEXT_PUBLIC_API_URL
# with the /api/v1 path removed.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Discovery voice-note helper is enabled by default; set this to false to hide
# the web control while the backend/provider configuration is unavailable.
NEXT_PUBLIC_DISCOVERY_VOICE_NOTES_ENABLED=true
