# Full URL of the NestJS API including the /api/v1 prefix.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Optional: explicit WebSocket gateway URL. Defaults to NEXT_PUBLIC_API_URL
# with the /api/v1 path removed.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Optional Discovery voice-note helper. Keep disabled until both the Nest and
# FastAPI voice-transcription flags and internal token are configured.
NEXT_PUBLIC_DISCOVERY_VOICE_NOTES_ENABLED=false
