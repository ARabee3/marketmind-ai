# MarketMind AI — local docker-compose env (n8n)
#
# Copy this file to `infra/docker/.env` (gitignored) and fill in real values.
# `docker compose -f infra/docker/docker-compose.local.yml` performs ${...}
# substitution from this file when bringing the n8n service up.
#
# IMPORTANT: the three PUBLISHING_N8N_* values below MUST match the same vars
# in `apps/api/.env` byte-for-byte. The API signs dispatch payloads with the
# signing secret/key and authenticates the outbound webhook with the auth
# token; n8n verifies both. Any drift → webhook 401 or signature mismatch.
#
# PUBLISHING_INTERNAL_SERVICE_TOKEN and PUBLISHING_CALLBACK_BASE_URL must also
# match `apps/api/.env`: the workflow forwards ONLY opaque attempt/intent/
# target ids to the API-owned Meta provider executor (issue #175). n8n never
# holds a Meta token of any kind — META_TEST_PAGE_ID / META_TEST_PAGE_ACCESS_TOKEN
# were removed from the real publishing path.

# ---------- PUBLISHING_N8N_* (must match apps/api/.env) ----------
# Bearer token the API sends to n8n's webhook (Authorization: Bearer <...>).
PUBLISHING_N8N_AUTH_TOKEN=
# HMAC signing secret used to sign/verify dispatch + callback envelopes.
PUBLISHING_N8N_SIGNING_SECRET=
# Optional key id for the signing secret (rotation seam). Leave empty for
# single-key mode; must match apps/api/.env PUBLISHING_N8N_SIGNING_KID.
PUBLISHING_N8N_SIGNING_KID=

# ---------- Internal executor token (must match apps/api/.env) ----------
# Sent by the workflow as `x-publishing-internal-token` when it calls the
# API-owned Meta provider executor
# (POST /internal/v1/publishing/execute-meta).
PUBLISHING_INTERNAL_SERVICE_TOKEN=

# ---------- API base URL (must match apps/api/.env) ----------
# Used by the workflow to reach the executor endpoint. With host networking,
# http://localhost:3001 resolves to the host-run API.
PUBLISHING_CALLBACK_BASE_URL=http://localhost:3001
