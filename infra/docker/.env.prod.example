# MarketMind AI — Production Environment
# Copy to `infra/docker/.env.prod` (gitignored) and fill in real values.
#
#   cp infra/docker/.env.prod.example infra/docker/.env.prod
#
# This file is consumed by `docker-compose.prod.yml` via variable
# substitution. App secrets themselves are NOT duplicated here — they are read
# from the existing gitignored `apps/api/.env` and `services/ai/.env` files
# via `env_file:` in the compose file.

# Public hostname (Caddy auto-provisions Let's Encrypt TLS for it).
# DuckDNS subdomain recommended for the demo.
CADDY_HOSTNAME=marketmindai.duckdns.org

# PostgreSQL superuser password used by the internal `postgres` service and
# passed to api/ai via DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME_strong_password